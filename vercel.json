{
  "git": { "deploymentEnabled": false },
  "crons": [
    {
      "path": "/api/cron/email-drip-campaign",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/email-drip",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/email-drip-optimized",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/reengagement-campaign",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "regions": [
    "sfo1",
    "iad1"
  ],
  "framework": "nextjs"
}
