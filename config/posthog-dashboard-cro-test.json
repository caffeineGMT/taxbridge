{
  "dashboard_name": "CRO Test March 2026 - Landing Page Headlines & CTAs",
  "description": "2x2 factorial test: 2 headlines × 2 CTAs = 4 variants. Target: 1000 visitors/variant, 15%+ CTR lift.",
  "insights": [
    {
      "name": "Visitor Distribution by Variant",
      "type": "TRENDS",
      "filters": {
        "events": [
          {
            "id": "landing_page_viewed",
            "name": "landing_page_viewed",
            "type": "events",
            "order": 0,
            "properties": [
              {
                "key": "experiment",
                "value": "cro-test-march-2026",
                "operator": "exact",
                "type": "event"
              }
            ]
          }
        ],
        "breakdown": "variant",
        "breakdown_type": "event",
        "display": "ActionsTable",
        "insight": "TRENDS",
        "interval": "day",
        "date_from": "2026-03-19",
        "date_to": "2026-04-02"
      },
      "description": "Daily visitors per variant - should be ~25% each"
    },
    {
      "name": "CTA Click-Through Rate by Variant",
