        "breakdown": "variant",
        "breakdown_type": "event",
        "funnel_viz_type": "steps",
        "insight": "FUNNELS",
        "date_from": "2026-03-19",
        "date_to": "2026-04-02"
      },
      "description": "PRIMARY METRIC: CTA click rate by variant"
