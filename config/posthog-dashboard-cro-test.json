              {
                "key": "experiment",
                "value": "cro-test-march-2026",
                "operator": "exact",
                "type": "event"
              }
            ],
            "math": "total"
          }
        ],
        "display": "ActionsLineGraphCumulative",
        "insight": "TRENDS",
        "interval": "day",
        "date_from": "2026-03-19",
        "date_to": "2026-04-02"
      },
      "description": "Cumulative visitors - target is 4,000 total (1,000 per variant)"
    },
    {
      "name": "Time on Page by Variant",
      "type": "TRENDS",
      "filters": {
        "events": [
          {
            "id": "landing_page_viewed",
            "name": "landing_page_viewed",
            "type": "events",
            "order": 0,
            "properties": [
              {
                "key": "experiment",
                "value": "cro-test-march-2026",
                "operator": "exact",
                "type": "event"
              }
            ],
            "math": "avg",
            "math_property": "$session_duration"
          }
        ],
        "breakdown": "variant",
        "breakdown_type": "event",
        "display": "ActionsBar",
        "insight": "TRENDS",
        "date_from": "2026-03-19",
        "date_to": "2026-04-02"
      },
      "description": "Average session duration - indicates engagement level"
    },
    {
      "name": "Bounce Rate by Variant",
      "type": "TRENDS",
      "filters": {
        "events": [
          {
            "id": "$pageview",
            "name": "$pageview",
            "type": "events",
            "order": 0,
            "properties": [
              {
                "key": "$current_url",
                "value": "/cro-test",
                "operator": "icontains",
                "type": "event"
              }
            ],
            "math": "dau"
          }
        ],
        "breakdown": "variant",
        "breakdown_type": "event",
        "display": "ActionsBar",
        "insight": "TRENDS",
        "date_from": "2026-03-19",
        "date_to": "2026-04-02"
      },
      "description": "Bounce rate indicator - lower is better"
    }
