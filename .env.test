# Test Environment Variables
# Used during Playwright E2E test runs

# Enable Playwright test mode to bypass authentication
PLAYWRIGHT_TEST_MODE=true

# Disable Clerk authentication checks in test mode
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_PLAYWRIGHT
CLERK_SECRET_KEY=sk_test_PLAYWRIGHT

# Disable Sentry in test mode
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Use localhost as base URL
BASE_URL=http://localhost:3000
