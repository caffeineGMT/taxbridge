# TaxBridge Production Environment Variables
# Copy this to .env.local and fill in with production values

# ═══════════════════════════════════════════════════════
# STRIPE PRODUCTION CONFIGURATION
# ═══════════════════════════════════════════════════════

# Get production keys from: https://dashboard.stripe.com/apikeys
# Toggle to "Production mode" in dashboard
STRIPE_SECRET_KEY=sk_live_YOUR_PRODUCTION_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY_HERE

# Get webhook secret after setting up webhook endpoint
# Webhook URL: https://your-domain.vercel.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET_HERE

# Run 'npm run setup:stripe' to create products and get these IDs
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID_HERE
STRIPE_ENTERPRISE_PRICE_ID=price_YOUR_ENTERPRISE_PRICE_ID_HERE
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID_HERE
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_YOUR_ENTERPRISE_PRICE_ID_HERE

# ═══════════════════════════════════════════════════════
# APP CONFIGURATION
# ═══════════════════════════════════════════════════════

# Your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://taxbridge.vercel.app

# Database path (absolute path recommended for production)
DATABASE_PATH=/var/data/taxbridge.db

# ═══════════════════════════════════════════════════════
# CLERK AUTHENTICATION
# ═══════════════════════════════════════════════════════

# Get production keys from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

# Clerk URLs (should match your domain)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ═══════════════════════════════════════════════════════
# EMAIL (SENDGRID)
# ═══════════════════════════════════════════════════════

# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=noreply@taxbridge.app
SENDGRID_FROM_NAME=TaxBridge
SENDGRID_REPLY_TO=support@taxbridge.app

# Create dynamic templates at: https://app.sendgrid.com/dynamic_templates
SENDGRID_TEMPLATE_WELCOME=d-YOUR_WELCOME_TEMPLATE_ID
SENDGRID_TEMPLATE_DAY3=d-YOUR_DAY3_TEMPLATE_ID
SENDGRID_TEMPLATE_DAY7=d-YOUR_DAY7_TEMPLATE_ID
SENDGRID_TEMPLATE_DAY14=d-YOUR_DAY14_TEMPLATE_ID

# ═══════════════════════════════════════════════════════
# AI FEATURES (ANTHROPIC)
# ═══════════════════════════════════════════════════════

# Get API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY_HERE

# ═══════════════════════════════════════════════════════
# CRON & SECURITY
# ═══════════════════════════════════════════════════════

# Generate a secure random string for cron endpoint protection
# Example: openssl rand -hex 32
CRON_SECRET=YOUR_SECURE_RANDOM_STRING_HERE

# ═══════════════════════════════════════════════════════
# ADMIN CONFIGURATION
# ═══════════════════════════════════════════════════════

# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@taxbridge.app,michael@taxbridge.app

# ═══════════════════════════════════════════════════════
# MONITORING & ANALYTICS (Optional)
# ═══════════════════════════════════════════════════════

# Sentry for error tracking
# NEXT_PUBLIC_SENTRY_DSN=

# PostHog for product analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ═══════════════════════════════════════════════════════
# DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════

# For Vercel deployment:
# 1. Go to your project settings
# 2. Navigate to Environment Variables
# 3. Add each variable above
# 4. Set environment to "Production"
# 5. Redeploy your application

# Alternative: Use Vercel CLI
# vercel env add VARIABLE_NAME production
