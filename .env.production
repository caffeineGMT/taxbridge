# ═══════════════════════════════════════════════════════
# TAXBRIDGE PRODUCTION ENVIRONMENT
# ═══════════════════════════════════════════════════════
# DO NOT COMMIT THIS FILE WITH REAL VALUES
# Use Vercel Dashboard to set production environment variables
#
# Setup Guide: See STRIPE_PRODUCTION_SETUP.md
# ═══════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════
# APP CONFIGURATION
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=https://taxbridge.app
NEXT_PUBLIC_BASE_URL=https://taxbridge.app
DATABASE_PATH=./data/taxbridge.db

# ═══════════════════════════════════════════════════════
# STRIPE PRODUCTION (LIVE MODE)
# ═══════════════════════════════════════════════════════
# 🔴 CRITICAL: These MUST be sk_live_ and pk_live_ keys
# Get from: https://dashboard.stripe.com/apikeys (toggle to "Production")
#
# ⚠️  SETUP REQUIRED:
# 1. Get production keys from Stripe dashboard
# 2. Run: npm run setup:stripe
# 3. Copy price IDs from script output
# 4. Add webhook endpoint: https://taxbridge.app/api/stripe/webhook
# 5. Copy webhook secret

STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LIVE_WEBHOOK_SECRET_HERE

# Stripe Price IDs (from npm run setup:stripe output)
# Pro Plan - Variant A (Annual $49 - Launch Special)
STRIPE_PRO_PRICE_ID=price_YOUR_LIVE_PRO_PRICE_ID
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_YOUR_LIVE_PRO_PRICE_ID

# Pro Plan - Variant B (Annual $79 - Standard) - PRICING EXPERIMENT
STRIPE_PRO_PRICE_ID_79=price_YOUR_LIVE_PRO_PRICE_ID_79
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_79=price_YOUR_LIVE_PRO_PRICE_ID_79

# Pro Plan - Monthly Option ($19/month)
STRIPE_PRO_PRICE_ID_MONTHLY=price_YOUR_LIVE_PRO_PRICE_ID_MONTHLY
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_MONTHLY=price_YOUR_LIVE_PRO_PRICE_ID_MONTHLY

# Enterprise Price ID
STRIPE_ENTERPRISE_PRICE_ID=price_YOUR_LIVE_ENTERPRISE_PRICE_ID
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_YOUR_LIVE_ENTERPRISE_PRICE_ID

# ═══════════════════════════════════════════════════════
# CLERK AUTHENTICATION (PRODUCTION)
# ═══════════════════════════════════════════════════════
# Get from: https://dashboard.clerk.com → API Keys → Production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ═══════════════════════════════════════════════════════
# AI TAX ADVISOR (ANTHROPIC)
# ═══════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY_HERE

# ═══════════════════════════════════════════════════════
# SENDGRID EMAIL (PRODUCTION)
# ═══════════════════════════════════════════════════════
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=noreply@taxbridge.app
SENDGRID_FROM_NAME=TaxBridge
SENDGRID_REPLY_TO=support@taxbridge.app

# Dynamic Template IDs
SENDGRID_CANCELLATION_SURVEY_TEMPLATE_ID=d-YOUR_CANCELLATION_SURVEY_TEMPLATE_ID

# ═══════════════════════════════════════════════════════
# SENTRY ERROR TRACKING
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_SENTRY_KEY@o0000000.ingest.sentry.io/0000000
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
SENTRY_ORG=taxbridge
SENTRY_PROJECT=cross-border-tax

# ═══════════════════════════════════════════════════════
# GOOGLE ADS CONVERSION TRACKING
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=YOUR_SIGNUP_LABEL
NEXT_PUBLIC_GOOGLE_ADS_PRO_LABEL=YOUR_PRO_SUBSCRIPTION_LABEL
NEXT_PUBLIC_GOOGLE_ADS_ENTERPRISE_LABEL=YOUR_ENTERPRISE_LABEL
NEXT_PUBLIC_GOOGLE_ADS_CALCULATOR_LABEL=YOUR_CALCULATOR_LABEL

# ═══════════════════════════════════════════════════════
# META PIXEL (FACEBOOK/INSTAGRAM RETARGETING)
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_META_PIXEL_ID=YOUR_15_DIGIT_PIXEL_ID

# ═══════════════════════════════════════════════════════
# POSTHOG ANALYTICS
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ═══════════════════════════════════════════════════════
# CRON & SECURITY
# ═══════════════════════════════════════════════════════
# Generate with: openssl rand -hex 32
CRON_SECRET=YOUR_SECURE_RANDOM_STRING_HERE

# ═══════════════════════════════════════════════════════
# ADMIN CONFIGURATION
# ═══════════════════════════════════════════════════════
ADMIN_EMAILS=admin@taxbridge.app,michael@taxbridge.app
RESEND_API_KEY=re_placeholder_key
