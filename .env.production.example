# TaxBridge Production Environment Variables
# Copy this file and configure with actual production values

# App Configuration
NEXT_PUBLIC_APP_URL=https://taxbridge.app

# Clerk Authentication (Production Instance)
# Get from: https://dashboard.clerk.com > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY_HERE

# Stripe Payment (Live Mode)
# Get from: https://dashboard.stripe.com > Developers > API Keys (toggle to Live mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com > Developers > Webhooks > Add endpoint
# Endpoint URL: https://taxbridge.app/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid Email Service
# Get from: https://app.sendgrid.com > Settings > API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@taxbridge.app
SENDGRID_FROM_NAME=TaxBridge
SENDGRID_REPLY_TO=support@taxbridge.app

# SendGrid Dynamic Template IDs
# Create in: https://app.sendgrid.com > Email API > Dynamic Templates
SENDGRID_TEMPLATE_WELCOME=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_DAY3=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_DAY7=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_DAY14=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API for AI Tax Advisor
# Get from: https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Cron Secret
# Generate with: openssl rand -hex 32
# Used to secure cron endpoints from unauthorized access
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Configuration
# Comma-separated list of admin emails for admin access
ADMIN_EMAILS=admin@taxbridge.app,michael@taxbridge.app

# Vercel Edge Config (Auto-generated)
# Link via: vercel edge-config link taxbridge-config
EDGE_CONFIG=https://edge-config.vercel.com/xxxxxxxxxxxxxxxxxxxxxx

# Optional: Sentry Error Tracking
# Get from: https://sentry.io > Settings > Projects > Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
# SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
