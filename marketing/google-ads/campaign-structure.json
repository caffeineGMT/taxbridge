  "optimization_schedule": {
    "week_1": {
      "action": "Monitor and gather data",
      "min_conversions": 10,
      "notes": "Let algorithm learn, don't make changes"
    },
    "week_2": {
      "action": "Pause low-performing keywords",
      "criteria": "CTR < 2% OR CPC > $20 OR no conversions",
      "notes": "Focus budget on winners"
    },
    "week_3": {
      "action": "Ad copy testing",
      "notes": "Launch 3 new variations per ad group, pause losers"
    },
    "week_4": {
      "action": "Bid optimization",
      "target": "CAC < $30 consistently",
      "notes": "Lower bids on high-performing keywords, increase budget if ROI positive"
    }
  }
