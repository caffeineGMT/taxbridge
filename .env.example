# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@taxbridge.app
SENDGRID_FROM_NAME=TaxBridge
SENDGRID_REPLY_TO=support@taxbridge.app

# SendGrid Dynamic Template IDs (7-Day Nurture Sequence)
# Create these in SendGrid Dashboard: https://app.sendgrid.com/dynamic_templates
# Day 1: Welcome + Calculator Tips
SENDGRID_TEMPLATE_DAY1=d-your-day1-template-id
# Day 3: Case Study (Social Proof)
SENDGRID_TEMPLATE_DAY3=d-your-day3-template-id
# Day 5: Limited Offer (30% off)
SENDGRID_TEMPLATE_DAY5=d-your-day5-template-id
# Day 7: Last Chance (Urgency)
SENDGRID_TEMPLATE_DAY7=d-your-day7-template-id

# Vercel Cron Secret (for securing cron endpoints)
CRON_SECRET=your_secure_random_string_here

# Clerk Authentication (if using)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe Payment (if using)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App Configuration
NEXT_PUBLIC_APP_URL=https://taxbridge.app

# Admin Configuration (comma-separated list of admin emails)
ADMIN_EMAILS=admin@taxbridge.app,yourname@example.com

# Anthropic API Key for AI Tax Advisor
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY_HERE

# PostHog Analytics & A/B Testing
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe Price IDs for Pricing Tiers
# Pro Plan - Variant A (Annual $49 - Launch Special)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_1ProAnnual49
# Pro Plan - Variant B (Annual $79 - Standard Pricing) - PRICING EXPERIMENT
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_79=price_1ProAnnual79
# Pro Plan - Monthly Option ($19/month)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_MONTHLY=price_1ProMonthly19
# Enterprise Plan
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_1EntAnnual

# Product Hunt Launch Monitoring
# Get API token from: https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_API_TOKEN=your_product_hunt_api_token_here
PRODUCT_HUNT_SLUG=taxbridge

# ═══════════════════════════════════════════════════════
# SENTRY ERROR TRACKING & MONITORING
# ═══════════════════════════════════════════════════════
# Get these from: https://sentry.io
# 1. Create a new project (select Next.js)
# 2. Copy the DSN from project settings
# 3. Generate auth token in Settings > Auth Tokens (scope: project:write)

NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-key@o0000000.ingest.sentry.io/0000000
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# ═══════════════════════════════════════════════════════
# CPA PARTNER OUTREACH CAMPAIGN APIS
# ═══════════════════════════════════════════════════════

# Apollo.io - B2B Contact & Company Database
# Sign up: https://app.apollo.io/api
# Pricing: $79/mo for 10,000 credits
# Used for: Finding immigration law firm contacts
APOLLO_API_KEY=your_apollo_api_key_here

# Hunter.io - Email Verification & Finder
# Sign up: https://hunter.io/api
# Pricing: $49/mo for 500 verifications (optional, can use NeverBounce instead)
# Used for: Verifying email addresses before sending
HUNTER_API_KEY=your_hunter_api_key_here

# Instantly.ai - Cold Email Automation
# Sign up: https://app.instantly.ai
# Pricing: $37/mo
# Used for: Email campaigns, warmup, tracking
# Note: Configure via web UI, no API key needed

# ═══════════════════════════════════════════════════════
# REDDIT ORGANIC GROWTH AUTOMATION
# ═══════════════════════════════════════════════════════

# Reddit API Configuration
# 1. Create Reddit account (e.g., TaxBridgeApp)
# 2. Go to https://www.reddit.com/prefs/apps
# 3. Click "Create App" → Choose "script" type
# 4. Fill in name, description, redirect URI (http://localhost:8080)
# 5. Copy Client ID (under app name) and Client Secret

REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=TaxBridgeApp
REDDIT_PASSWORD=your_secure_password_here
REDDIT_USER_AGENT=TaxBridge:v1.0.0 (by /u/TaxBridgeApp)
